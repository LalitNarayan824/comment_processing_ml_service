# .env.example — Copy to .env and fill in values

# Device: -1 = CPU, 0 = GPU
DEVICE=-1

# Thread pool workers for heavy inference
MAX_WORKERS=4

# Model identifiers (override to use different models)
# INTENT_MODEL=lalit-narayan/youtube-comment-intent-classifier
# TOXICITY_MODEL=martin-ha/toxic-comment-model
# SENTIMENT_MODEL=AmaanP314/youtube-xlm-roberta-base-sentiment-multilingual
# SPAM_MODEL=valurank/distilroberta-spam-comments-detection

# Thresholds
SPAM_ML_THRESHOLD=0.75
SPAM_SCORE_THRESHOLD=3
TOXICITY_THRESHOLD=0.7

# Paths
BLOCKLIST_PATH=data/blocklist.txt

# Server
HOST=0.0.0.0
PORT=7860
